# Clean URLs — strip .html extension
/about.html             /about                  301
/contact.html           /contact                301
/privacy.html           /privacy                301
/terms.html             /terms                  301

# Services — strip .html
/services/:slug.html    /services/:slug         301

# Areas — strip .html
/areas/:slug.html       /areas/:slug            301

# Blog — strip .html
/blog/:slug.html        /blog/:slug             301

# Trailing slash normalisation for index pages
/services               /services/              301
/areas                  /areas/                 301
/blog                   /blog/                  301

# 404 fallback
/*                      /404.html               404
